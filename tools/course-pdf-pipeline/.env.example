# 通义千问 / DashScope（OpenAI 兼容模式）
QWEN_API_KEY=sk-xxxxxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 可选：国际站
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 可选：阿里云 Model Studio / 专属兼容端点
# QWEN_BASE_URL=https://your-endpoint.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 服务
HOST=127.0.0.1
PORT=8765
MAX_UPLOAD_MB=50

# 本地串行扫描根目录（默认指向仓库内 课程/）
# COURSE_PDF_ROOT=C:\Users\Administrator\Desktop\polyu_student_community\课程
# AUTO_EXPORT=true
