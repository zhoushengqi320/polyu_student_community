# Supabase（Vercel Production 必填）
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 站点 URL（Magic Link 回调；本地用 localhost，生产用 https://你的域名，勿带末尾斜杠）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 仅本地脚本使用：导入课程 / 指南内容时需要绕过 RLS
# 不要配置到 Vercel，不要提交真实值
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 可选：Supabase Management API（配置生产 Auth 回调 URL 时用）
# Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# --- 生产部署（Railway 推荐）---
# 1. railway.app → Deploy from GitHub → 选本仓库
# 2. Settings → Networking → Generate Domain
# 3. Variables 添加下面三个 NEXT_PUBLIC_*（SITE_URL 用 https://你的域名.up.railway.app）
# 4. Supabase Auth → Site URL + Redirect URLs（见 README）
# 5. 验收：https://你的域名/api/health
