# Supabase（前端，必须 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxx"

# 应用根 URL（Magic Link redirectTo；本地/线上分别配置，勿带末尾斜杠）
# 本地：
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 线上（腾讯云 / polyuhub.com）：
# NEXT_PUBLIC_APP_URL="https://polyuhub.com"

# 兼容旧变量名（未设置 APP_URL 时使用）
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 仅服务端使用，不要加 NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY="xxx"

# 可选：Supabase Management API（配置生产 Auth 回调 URL 时用）
# Dashboard → Account → Access Tokens
SUPABASE_ACCESS_TOKEN="your_supabase_access_token"

# --- 认证 ---
# 本地开发 true：页面直接展示 OTP，不发真实邮件；生产务必 false
DEV_SHOW_LOGIN_OTP=false

# 一键恢复 Magic Link 登录入口（默认关闭；代码完整保留）
AUTH_ENABLE_MAGIC_LINK=false

# OTP / 注册草稿加密（生产建议单独配置强随机串）
# OTP_PEPPER="random-long-string"
# REGISTRATION_DRAFT_SECRET="random-long-string"

# 生产发信（二选一）：Resend 或 SMTP。未配置且 DEV_SHOW_LOGIN_OTP=false 时无法发验证码
# RESEND_API_KEY="re_xxx"
# RESEND_FROM_EMAIL="PolyUHub <noreply@yourdomain.com>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user"
# SMTP_PASS="pass"
# SMTP_FROM="PolyUHub <noreply@yourdomain.com>"

# --- 生产服务器（腾讯云）---
# 1. .env.local / pm2 env 设置：
#    NEXT_PUBLIC_APP_URL="https://polyuhub.com"
#    DEV_SHOW_LOGIN_OTP=false
# 2. 在 Supabase SQL Editor 执行 supabase/migrations/018_auth_password_otp_profile_review.sql
# 3. npm run build && pm2 reload polyuhub
# 4. Supabase → Authentication → URL Configuration：
#    Site URL = https://polyuhub.com
#    Redirect URLs 包含 https://polyuhub.com/auth/callback
# 5. 验收：注册发 OTP → 设密码 → 填年级专业 → 登录；管理后台「资料审核」
